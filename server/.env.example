# Puerto donde escucha el servidor Colyseus/Express.
PORT=2567

# Fase 7 (streamers) — cuando se conecte el login OAuth real de Twitch en vez de
# la whitelist manual actual, estos van acá. Nunca se commitean valores reales:
# copiá este archivo a server/.env y completalo localmente / en el panel de
# variables de entorno del host (Fly.io, Railway, etc.).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# JWT_SECRET=
